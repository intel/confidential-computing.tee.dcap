  <!-- Copy license files into the WDK package staging dir before inf2cat inspects it.
       The PreBuildEvent copies them to $(TargetDir); the WDK PackagingOutput target
       creates $(OutDir)$(TargetName)\ but does not include them, so inf2cat error 22.9.1
       fires. Running this target BeforeTargets="Inf2Cat" ensures they are present.
       Source paths use $(TargetDir) to match the PreBuildEvent copy destination. -->
  <Target Name="CopyLicensesToPackageDir" BeforeTargets="Inf2Cat">
    <MakeDir Directories="$(OutDir)$(TargetName)" />
    <Copy SourceFiles="$(TargetDir)License.txt"
          DestinationFolder="$(OutDir)$(TargetName)"
          Condition="Exists('$(TargetDir)License.txt')" />
    <Copy SourceFiles="$(TargetDir)ThirdPartyLicenses.txt"
          DestinationFolder="$(OutDir)$(TargetName)"
          Condition="Exists('$(TargetDir)ThirdPartyLicenses.txt')" />
  </Target>
